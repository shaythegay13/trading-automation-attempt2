# Variable names only. No values are stored in this file.
# Copy to .env and uncomment a line only when you want to override the default
# in src/config.py. Defaults are documented in README.md.
# An empty assignment (NAME=) overrides the default with an empty string, so
# leave unused lines commented.

# DATABASE_URL=
# KALSHI_TIER1_INTERVAL_SECONDS=
# KALSHI_TIER2_INTERVAL_SECONDS=
# POLYMARKET_INTERVAL_SECONDS=
# POLL_INTERVAL_SECONDS=
# KALSHI_RATE_LIMIT_RPS=
# POLYMARKET_RATE_LIMIT_RPS=
# MAX_SPREAD_FOR_TWO_SIDED=
# MIN_VOLUME_FOR_TIER2=
# TIER2_MAX_MARKETS_PER_CYCLE=
# KALSHI_MAX_PAGES=
# TIER1_WRITE_UNCHANGED=
# KALSHI_SLOW_TIER_INTERVAL_SECONDS=
# KALSHI_EXCLUDED_CATEGORIES=
# KALSHI_RETENTION_MONTHS=
# LOG_LEVEL=

# Safety switch. Leave unset. The runner has no order client; if this is true
# it refuses to start instead of trading.
# LIVE_TRADING_ENABLED=
